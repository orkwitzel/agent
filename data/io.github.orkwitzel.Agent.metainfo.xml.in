<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Agent</name>
  <summary>Work with AI coding agents</summary>
  <description>
    <p>
      Agent is a native GNOME client for AI coding agents. It drives the
      Claude Code command-line tool you already have installed and signed in,
      so it works with your existing subscription or API key.
    </p>
    <p>Agent is not affiliated with or endorsed by Anthropic.</p>
  </description>
  <developer id="io.github.orkwitzel">
    <name>Or Kwitzel</name>
  </developer>
  <url type="homepage">https://github.com/orkwitzel/agent</url>
  <url type="bugtracker">https://github.com/orkwitzel/agent/issues</url>
  <url type="vcs-browser">https://github.com/orkwitzel/agent</url>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">agent</translation>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <releases>
    <release version="0.1.0" date="2026-10-07">
      <description translate="no">
        <p>Project scaffold.</p>
      </description>
    </release>
  </releases>
</component>
